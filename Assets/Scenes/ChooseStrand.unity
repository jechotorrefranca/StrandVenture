  m_Name: 
  m_EditorClassIdentifier: 
  strands:
  - name: TVL
    description: Build hands-on technical skills in hospitality, tourism, and culinary
      arts. Ideal for students aiming to become chefs, bakers, baristas, service
      crew, tour guides, or future professionals in the food and service industries
    cardObject: {fileID: 895834039}
    outlineTarget: {fileID: 126400039}
    bestBadge: {fileID: 95837477}
  - name: ABM
    description: Master the skills of leadership, entrepreneurship, and finance.
      Perfect for future business leaders, accountants, and managers.
    cardObject: {fileID: 1880147482}
    outlineTarget: {fileID: 1396267239}
    bestBadge: {fileID: 1467702552}
  - name: ICT
    description: Learn the latest in technology and digital systems. A great fit
      for tech-savvy students aiming for careers in programming, web development,
      and IT.
    cardObject: {fileID: 80232208}
    outlineTarget: {fileID: 1864888472}
    bestBadge: {fileID: 402872288}
  - name: STEM
    description: Explore the world of science, innovation, and problem-solving. This
      strand is perfect for future scientists, engineers, doctors, and tech enthusiasts.
    cardObject: {fileID: 611995539}
    outlineTarget: {fileID: 74077811}
    bestBadge: {fileID: 1822037778}
  - name: HUMSS
    description: Dive into the study of human behavior, culture, and society. Ideal
      for aspiring teachers, writers, psychologists, and public service professionals.
    cardObject: {fileID: 653945757}
    outlineTarget: {fileID: 678164245}
    bestBadge: {fileID: 152222953}
  - name: Maritime
    description: Set sail toward a career on the seas. This strand equips students
      with knowledge in navigation, seamanship, and marine engineering, ideal for
      future sailors, marine officers, and ship engineers.
    cardObject: {fileID: 953419005}
    outlineTarget: {fileID: 125693112}
    bestBadge: {fileID: 2113349709}
